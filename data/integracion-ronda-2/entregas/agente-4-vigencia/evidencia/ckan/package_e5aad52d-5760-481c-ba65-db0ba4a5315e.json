{"help": "https://datos.sonora.gob.mx/api/3/action/help_show?name=package_show", "success": true, "result": {"author": null, "author_email": null, "creator_user_id": "2dd465c3-0e73-432e-a2d8-e30dc297d563", "data_source": "base_de_datos_interna", "frequency": "cuatrimestral", "fuentes_extras": "", "granularidad_datos": "categor\u00eda_tipo", "id": "e5aad52d-5760-481c-ba65-db0ba4a5315e", "isopen": true, "jurisdiccion": "municipal", "license_id": "cc-by", "license_title": "Creative Commons Attribution", "license_url": "http://www.opendefinition.org/licenses/cc-by", "maintainer": null, "maintainer_email": null, "metadata_created": "2025-03-20T21:10:15.128413", "metadata_modified": "2026-08-05T17:53:53.718761", "name": "Matriculas", "notes": "Base de datos de la matr\u00edcula inscrita durante el cuatrimestre a consultar. Informaci\u00f3n clasificada por:  nivel, modalidad, programa educativo, campo de formaci\u00f3n acad\u00e9mica, cuatrimestre, sexo, estado de nacimiento, estado civil y edad.", "num_resources": 16, "num_tags": 3, "numero_variables": "11", "organization": {"id": "f353bb81-d268-40cd-aa74-d3f53402189a", "name": "uth", "title": "Universidad Tecnol\u00f3gica de Hermosillo", "type": "organization", "description": "Nuestra misi\u00f3n es formar profesionales con un alto sentido de internalizaci\u00f3n, comprometidos con el desarrollo econ\u00f3mico, social, pol\u00edtico y cultural del entorno y con una conciencia sustentable de los recursos, vinculando el proceso ense\u00f1anza aprendizaje con la investigaci\u00f3n y extensionismo cient\u00edfico y tecnol\u00f3gico.", "image_url": "2025-01-29-195816.234065image2025-01-29125759916.png", "created": "2025-01-29T19:58:16.244501", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "f353bb81-d268-40cd-aa74-d3f53402189a", "private": false, "state": "active", "title": "Matriculas", "type": "dataset", "url": null, "version": null, "groups": [{"description": "Esta secci\u00f3n est\u00e1 dise\u00f1ada para que los organismos gubernamentales compartan datos que reflejen la situaci\u00f3n educativa en Sonora; ofreciendo una visi\u00f3n de los esfuerzos, avances y desaf\u00edos en la formaci\u00f3n de los sonorenses, siendo un punto de referencia para entender y valorar la calidad educativa en nuestro territorio.", "display_name": "Educaci\u00f3n ", "id": "b7cfa661-69e2-4741-a955-c1a447665f6b", "image_display_url": "https://datos.sonora.gob.mx/uploads/group/2023-09-29-211756.137250Grupo-Educacion.jpg", "name": "educacion", "title": "Educaci\u00f3n "}], "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2025-03-20T21:10:15.297740", "datastore_active": false, "description": null, "end_date": "1989-06-04", "format": "XLSX", "hash": "", "id": "dc87a5be-8ef7-4e90-af72-ea5053423fad", "last_modified": "2025-03-25T16:10:50.685495", "metadata_modified": "2025-03-25T16:10:50.704396", "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "mimetype_inner": null, "name": "Diccionario", "package_id": "e5aad52d-5760-481c-ba65-db0ba4a5315e", "position": 0, "region": "-", "resource_type": null, "responsible": "-", "responsible_puesto": "-", "size": 12431, "start_date": "1989-06-04", "state": "active", "url": "https://datos.sonora.gob.mx/dataset/e5aad52d-5760-481c-ba65-db0ba4a5315e/resource/dc87a5be-8ef7-4e90-af72-ea5053423fad/download/diccionario-matricula-institucional.xlsx", "url_type": "upload"}, {"cache_last_updated": null, "cache_url": null, "created": "2025-03-20T21:24:52.720914", "datastore_active": false, "description": null, "email_publisher": "-", "end_date": "1989-06-04", "format": "XLSX", "hash": "", "id": "aaf0c6c1-76a7-40ac-b542-1319d1bb2a5a", "last_modified": "2025-03-20T21:24:52.695536", "metadata_modified": "2025-03-20T21:28:03.092199", "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "mimetype_inner": null, "name": "Catalogo", "package_id": "e5aad52d-5760-481c-ba6