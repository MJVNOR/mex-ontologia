PREFIX mex: <https://example.org/mex-ontologi/vocab/> PREFIX dct: <http://purl.org/dc/terms/> SELECT ?v ?def ?conjunto WHERE { ?v mex:nombreVariableLocal "a\u00f1o_matrimonio" ; mex:definicionOriginal ?d . ?d dct:description ?def . OPTIONAL { ?ds mex:variableDocumentada ?v ; dct:title ?conjunto } } 