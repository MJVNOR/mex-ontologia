PREFIX mex: <https://example.org/mex-ontologi/vocab/> PREFIX dct: <http://purl.org/dc/terms/> SELECT ?var ?conjunto ?desc WHERE { ?v mex:nombreVariableLocal "CLUES"; mex:estadoSemantico "candidata_sin_definicion_suficiente" . BIND(STR(?v) AS ?var) OPTIONAL { ?d mex:variableDocumentada ?v; dct:title ?conjunto } OPTIONAL { ?v mex:definicionOriginal ?o . ?o dct:description ?desc } } ORDER BY ?var