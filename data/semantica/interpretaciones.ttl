    mex:evidenciaRevisionJson "{\"id\": \"O-anio-div2023\", \"tipo\": \"observacion\", \"observacion_id\": \"anio-divorcios-2023\", \"campo\": \"anio_registro\", \"recurso\": \"f05dfd7e-88c9-42c4-ab88-e849fc277155\", \"huella_fila_diccionario\": null, \"clasificacion\": \"ya_resuelto_en_integracion\", \"afirma_con_limite\": \"Alias limitado solo-columna revisado en la integracion (columna indicada, huella de esquema y de fila citadas). Se cita, no se re-promueve.\", \"no_afirma\": \"No se generaliza a otros recursos.\", \"pregunta_id\": null, \"campo_original\": \"anio_registro\", \"variable_diccionario_original\": \"año_registro\", \"texto_observacion_original\": \"El esquema de Divorcios 2023 usa anio_registro, mientras el diccionario usa año_registro. Requiere revisión explícita de alias para este recurso; no se extiende la revisión de 2022.\", \"revision_existente\": {\"recurso\": \"f05dfd7e-88c9-42c4-ab88-e849fc277155\", \"campo\": \"anio_registro\", \"columna\": \"https://example.org/mex-ontologi/file-column/f05dfd7e-88c9-42c4-ab88-e849fc277155%2FCSV%2F3\", \"diccionario\": \"10357304-e171-44ca-a453-f989e6a2ff83\", \"concepto\": \"anio-registro\", \"variable\": \"año_registro\", \"criterio\": \"Alias especifico para esta columna con evidencia tecnica (mojibake/ASCII) + misma posicion, conjunto y descripcion de regla. No global.\", \"descripcion\": \"Año de registro del divorcio\", \"huella_esquema\": \"a8742634540ea7dba61cca9100c7c73a9625a1b0bc3b9436772cee670546c707\", \"huella_fila_diccionario\": \"bfe24badda4b4ffe8fce56569522d4ef0353e53c3b698a79503c91f4731375bb\", \"fuente_revision\": \"data/integracion/entregas/agente-4-correspondencias/propuestas.json\"}, \"columna_iri\": \"https://example.org/mex-ontologi/file-column/f05dfd7e-88c9-42c4-ab88-e849fc277155%2FCSV%2F3\", \"huella_esquema\": \"a8742634540ea7dba61cca9100c7c73a9625a1b0bc3b9436772cee670546c707\", \"sintesis\": \"Alias especifico solo-columna ya revisado en la integracion; se cita sin generalizar.\"}" ;
