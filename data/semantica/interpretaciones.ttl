<https://example.org/mex-ontologi/query-pipeline-evaluation/9c99f01ac85f2b1711e61fbd2fa37bdb703adb2486ada1eb49477bf777490097> a mex:EvaluacionPipelineConsulta ;
    rdfs:label "Ronda 2: diagnóstico parcial del pipeline fuente, UI sin evaluar"@es ;
    prov:wasDerivedFrom <file:///C:/Users/marti/Documents/MEX-Ontologi/data/integracion-ronda-2/entregas/agente-5-evaluacion-chat/registro.json> ;
