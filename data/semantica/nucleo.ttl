<https://example.org/mex-ontologi/connection-condition/catalogo> a mex:CondicionConexion ;
    rdfs:label "Comprobar catalogo"@es ;
    dct:description "Identificar el mismo catálogo y su versión, o una correspondencia explícita de identificadores con evidencia. Parecerse numéricamente no basta."@es ;
    prov:wasDerivedFrom <file:///C:/Users/marti/Documents/MEX-Ontologi/ontologia/semantica.json> .

<https://example.org/mex-ontologi/connection-condition/contexto> a mex:CondicionConexion ;
    rdfs:label "Comprobar contexto"@es ;
    dct:description "Conservar entidad para códigos municipales y entidad/municipio para localidades cuando el identificador lo requiera."@es ;
    prov:wasDerivedFrom <file:///C:/Users/marti/Documents/MEX-Ontologi/ontologia/semantica.json> .

<https://example.org/mex-ontologi/connection-condition/grano> a mex:CondicionConexion ;
    rdfs:label "Comprobar grano"@es ;
    dct:description "Comprobar unicidad y cardinalidad; agregar al mismo nivel antes de unir medidas y evitar multiplicación de filas."@es ;
    prov:wasDerivedFrom <file:///C:/Users/marti/Documents/MEX-Ontologi/ontologia/semantica.json> .

<https://example.org/mex-ontologi/connection-condition/periodo> a mex:CondicionConexion ;
    rdfs:label "Comprobar periodo"@es ;
    dct:description "Distinguir evento temporal y cobertura declarada frente a observada; no equiparar registro con ocurrencia."@es ;
    prov:wasDerivedFrom <file:///C:/Users/marti/Documents/MEX-Ontologi/ontologia/semantica.json> .

<https://example.org/mex-ontologi/connection-condition/rol> a mex:CondicionConexion ;
    rdfs:label "Comprobar rol"@es ;
    dct:description "Conservar la función y población de referencia: registro, residencia, ocurrencia, madre, difunto u organización capturadora/publicadora."@es ;
    prov:wasDerivedFrom <file:///C:/Users/marti/Documents/MEX-Ontologi/ontologia/semantica.json> .

<https://example.org/mex-ontologi/connection-condition/unidad> a mex:CondicionConexion ;
    rdfs:label "Comprobar unidad"@es ;
    dct:description "Identificar unidad, población y regla de agregación de cada medida; no sumar promedios ni interpretar vacíos como cero."@es ;
    prov:wasDerivedFrom <file:///C:/Users/marti/Documents/MEX-Ontologi/ontologia/semantica.json> .

