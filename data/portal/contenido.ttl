<https://example.org/mex-ontologi/cross/registro-civil-2022> a mex:CruceAgregado ;
    rdfs:label "Cruce exploratorio: matrimonios y divorcios registrados en 2022"@es ;
    dct:description "Cruce exploratorio dentro del Registro Civil de Sonora. Coincidencia de códigos locales y definiciones; catálogo oficial de correspondencia no publicado en estos diccionarios."@es ;
    prov:wasDerivedFrom <https://datos.sonora.gob.mx/api/3/action/datastore_search?resource_id=7b8638e8-d0d5-4311-b43f-51e2d343efb1&fields=_id%2Cmunicipio%2Ca%C3%B1o_matrimonio&sort=_id+asc&limit=5000&offset=0>,
