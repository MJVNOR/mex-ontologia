PREFIX mex: <https://example.org/mex-ontologi/vocab/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?m ?col ?et ?est WHERE { ?m mex:columnaOrigen ?c; mex:estadoCorrespondencia ?est . ?c rdfs:label ?et . BIND(STR(?c) AS ?col) BIND(STR(?m) AS ?m) FILTER(CONTAINS(LCASE(STR(?et)), "precipitacion")) } ORDER BY ?et