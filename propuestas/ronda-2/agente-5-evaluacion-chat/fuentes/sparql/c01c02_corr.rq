PREFIX mex: <https://example.org/mex-ontologi/vocab/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?nombre ?estado ?columna ?etiqueta WHERE { ?m mex:variableDestino ?v; mex:estadoCorrespondencia ?estado; mex:columnaOrigen ?c . ?v mex:nombreVariableLocal ?nombre . FILTER(?nombre IN ("a\u00f1o_matrimonio","a\u00f1o_defuncion")) ?c rdfs:label ?etiqueta . BIND(STR(?c) AS ?columna) } ORDER BY ?nombre ?estado