 const EFFECTIVE_MODEL = process.env.ONTO_LLM_MODEL ?? '';
+
+// El presupuesto de contexto solo entra si retrieve() recibe el modelo. Si el
+// sidecar arranco sin ONTO_LLM_MODEL en su entorno, EFFECTIVE_MODEL es '' y el
+// trim NUNCA aplica (budgetForModel(undefined) -> Infinity): los prompts viajan
+// sin recorte (medido: C6 ~488KB/~140k est) y el gateway devuelve 500 solo en
+// los casos grandes. Se resuelve el id real una vez via describe() (usa /models
+// como fallback ya existente) y se reutiliza. Sin red adicional por pregunta.
+let budgetModel: string | undefined = EFFECTIVE_MODEL || undefined;
+async function getBudgetModel(): Promise<string | undefined> {
+  if (budgetModel) return budgetModel;
+  try { budgetModel = await provider.describe(); } catch { /* como antes: sin presupuesto */ }
+  return budgetModel;
+}
