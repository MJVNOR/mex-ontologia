+/** Extrae `retryDelay: "Ns"` de un cuerpo RetryInfo; 0 si ausente. Tope 120s. */
+export function parseRetryDelayMs(bodyText: string): number {
+  try {
+    const m = String(bodyText ?? '').match(/"retryDelay"\s*:\s*"(\d+(?:\.\d+)?)s"/);
+    if (m) return Math.min(Math.round(Number(m[1]) * 1000), 120000);
+  } catch { /* sin retardo declarado */ }
+  return 0;
+}
+function sleep(ms: number): Promise<void> {
+  return new Promise(resolve => setTimeout(resolve, ms));
+}
