# Detalle: un concepto caso-con-* con su definicion y sus variables documentadas.
# Ejemplo con caso-con-cefalea-frontal; sustituir el IRI para cualquier otro id de la matriz.
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mex: <https://example.org/mex-ontologi/>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?concept ?prefLabel ?definition ?variable ?varLabel ?varDescription ?regla WHERE {
  VALUES ?concept { mex:concept/caso-con-cefalea-frontal }
  ?concept skos:prefLabel ?prefLabel ;
           skos:definition ?definition .
  OPTIONAL { ?concept skos:broader ?broaderPadre . }
  ?variable mex:significadoDocumentado ?concept .
  OPTIONAL { ?variable rdfs:label ?varLabel .
             ?variable dct:description ?varDescription .
             ?variable mex:reglaSemantica ?regla . }
}
