@prefix ex: <https://example.org/mex-ontologi/prueba-s-shacl/> .
@prefix mex: <https://example.org/mex-ontologi/vocab/> .

ex:c-revisada a mex:CorrespondenciaSemantica ;
    mex:estadoCorrespondencia "documental_revisada" ;
    mex:huellaEsquemaRevisado "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" .

ex:c-candidata a mex:CorrespondenciaSemantica ;
    mex:estadoCorrespondencia "candidata_por_nombre" .
