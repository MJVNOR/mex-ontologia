@prefix ex: <https://example.org/mex-ontologi/prueba-s-shacl/> .
@prefix mex: <https://example.org/mex-ontologi/vocab/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Condición sin descripción; municipio sin procedencia.
ex:condicion-sin-descripcion a mex:CondicionConexion ;
    rdfs:label "Comprobar unidad" ;
    prov:wasDerivedFrom <https://example.org/fuente/semantica.json> .

ex:municipio-sin-procedencia a mex:MunicipioSegunFuente ;
    rdfs:label "Aconchi" .
