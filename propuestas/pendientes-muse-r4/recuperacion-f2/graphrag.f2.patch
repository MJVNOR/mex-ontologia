+        : '';
+    const sampleAll = await selectAll(mcp, `${P}
+      # cruce-sample
+      SELECT DISTINCT ?c ?cl ?per WHERE {
+        ?c <https://example.org/mex-ontologi/vocab/comparacionDe> <${iri}> .
+        OPTIONAL { ?c <https://example.org/mex-ontologi/vocab/periodoCruzado> ?per }
