+        ?c <https://example.org/mex-ontologi/vocab/comparacionDe> <${iri}> .
+        ?c <https://example.org/mex-ontologi/vocab/periodoCruzado> ?per .
+      } ORDER BY ?per`);
+    const rolesMed = await selectAll(mcp, `${P}
