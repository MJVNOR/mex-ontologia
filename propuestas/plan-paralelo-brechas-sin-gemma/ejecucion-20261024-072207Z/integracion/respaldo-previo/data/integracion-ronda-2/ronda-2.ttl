    mex:objetoRevisado <https://example.org/mex-ontologi/file-column/ad6f77b8-569d-4826-8ce0-3c6efddcb098%2FEgresos%20Hospitalarios%202018-2022%2F15> ;
    mex:preguntaPublicador "Para Total_Egresos del recurso ad6f77b8 (diccionario f89137ba, huella 98c73e..., descripcion original 'Total de urgencias atendidas'): aclarar si la columna cuenta egresos hospitalarios o urgencias atendidas, y corregir el nombre o la descripcion para que coincidan." ;
    mex:tipoPendiente "observacion" .

