<https://example.org/mex-ontologi/concept/anio-censo> a skos:Concept,
        mex:ConceptoCompartido ;
    rdfs:label "Año de referencia del censo"@es ;
    skos:broader <https://example.org/mex-ontologi/concept/anio> ;
    skos:definition "Año de referencia del censo según la fuente; no equivale automáticamente al año de captura."@es ;
    skos:inScheme <https://example.org/mex-ontologi/concept-scheme/nucleo-compartido> ;
    skos:prefLabel "Año de referencia del censo"@es ;
    prov:wasDerivedFrom <file:///C:/Users/marti/Documents/MEX-Ontologi/ontologia/semantica.json> ;
    mex:requiereCondicion <https://example.org/mex-ontologi/connection-condition/catalogo>,
        <https://example.org/mex-ontologi/connection-condition/contexto>,
        <https://example.org/mex-ontologi/connection-condition/grano>,
