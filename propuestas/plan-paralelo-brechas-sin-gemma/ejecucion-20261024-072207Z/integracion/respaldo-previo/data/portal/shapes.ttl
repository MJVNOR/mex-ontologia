            sh:path mex:evidenciaTextual ],
        [ sh:datatype rdf:langString ;
            sh:minCount 1 ;
            sh:path mex:limiteSemantico ] ;
    sh:targetSubjectsOf mex:huellaEsquemaRevisado .

shape:RevisionVigenciaCatalogo a sh:NodeShape ;
    sh:property [ sh:class mex:ReferenciaCatalogoDeclarada ;
            sh:maxCount 1 ;
