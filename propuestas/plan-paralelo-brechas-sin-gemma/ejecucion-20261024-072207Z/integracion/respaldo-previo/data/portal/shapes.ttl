        [ sh:hasValue "no_documentada" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path mex:estadoVigencia ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path prov:wasDerivedFrom ] ;
    sh:targetClass mex:ReferenciaTerritorial .

shape:Registro a sh:NodeShape ;
