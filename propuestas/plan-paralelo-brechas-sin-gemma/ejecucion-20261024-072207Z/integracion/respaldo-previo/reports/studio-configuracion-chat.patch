+fn parse_agent_env(contents: &str) -> Result<BTreeMap<String, String>, String> {
+    let allowed = ["ONTO_PROVIDER", "ONTO_LLM_BASE_URL", "ONTO_LLM_MODEL", "ONTO_LLM_API_KEY", "ONTO_NODE_BINARY"];
+    let mut settings = BTreeMap::new();
+    for (index, line) in contents.trim_start_matches('\u{feff}').lines().enumerate() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') { continue; }
+        let Some((key, value)) = line.split_once('=') else {
+            return Err(format!("Invalid .env assignment at line {}", index + 1));
+        };
+        let key = key.trim();
+        if !allowed.contains(&key) { continue; }
+        let value = value.trim();
+        let value = if value.len() >= 2 && ((value.starts_with('"') && value.ends_with('"')) || (value.starts_with('\'') && value.ends_with('\''))) {
+            &value[1..value.len() - 1]
+        } else { value };
+        if value.is_empty() {
+            return Err(format!("Falta {} en el .env del chat", key));
+        }
+        settings.insert(key.to_string(), value.to_string());
+    }
+    for key in &allowed[..4] {
+        if !settings.contains_key(*key) {
+            return Err(format!("Falta {} en el .env del chat", key));
+        }
+    }
+    Ok(settings)
+}
+
+fn load_agent_settings(executable_dir: &Path) -> Result<BTreeMap<String, String>, String> {
+    // This file stores only a path. Credentials stay in the user's ignored .env.
+    let pointer = executable_dir.join("agent-env-path.txt");
+    if !pointer.exists() { return Ok(BTreeMap::new()); }
+    let path = std::fs::read_to_string(pointer)
+        .map_err(|_| "No se pudo leer agent-env-path.txt".to_string())?;
+    let path = Path::new(path.trim().trim_start_matches('\u{feff}'));
+    if !path.is_absolute() {
+        return Err("agent-env-path.txt debe contener la ruta absoluta al .env del chat".into());
+    }
+    let contents = std::fs::read_to_string(path)
+        .map_err(|_| "No se pudo leer el .env configurado para el chat".to_string())?;
+    parse_agent_env(&contents)
+}
