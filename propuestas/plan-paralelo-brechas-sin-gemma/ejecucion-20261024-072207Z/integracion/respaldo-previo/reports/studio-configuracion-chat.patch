+fn node_entry_path(path: PathBuf) -> PathBuf {
+    // Tauri returns Windows verbatim paths. Node 22 fails with EISDIR at
+    // "C:" when realpathSync receives a \\?\-prefixed entry point.
+    let text = path.to_string_lossy();
+    if let Some(unc) = text.strip_prefix(r"\\?\UNC\") {
+        return PathBuf::from(format!(r"\\{}", unc));
+    }
+    if let Some(disk) = text.strip_prefix(r"\\?\") {
+        return PathBuf::from(disk);
+    }
+    path
+}
