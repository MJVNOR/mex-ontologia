+function CopyButton({ text, label = 'Copiar', title = 'Copiar mensaje', color = 'var(--text-secondary)' }: {
+  text: string;
+  label?: string;
+  title?: string;
+  color?: string;
+}) {
+  const [status, setStatus] = useState<'idle' | 'copied' | 'error'>('idle');
+  const timer = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);
+  useEffect(() => () => clearTimeout(timer.current), []);
+
+  async function copy() {
+    clearTimeout(timer.current);
+    try {
+      await navigator.clipboard.writeText(text);
+      setStatus('copied');
+    } catch {
+      setStatus('error');
+    }
+    timer.current = setTimeout(() => setStatus('idle'), 2500);
+  }
+
+  return (
+    <button type="button" onClick={() => void copy()} disabled={!text}
+      title={status === 'error' ? 'No se pudo copiar. Vuelve a intentarlo.' : title}
+      aria-label={title}
+      className="text-xs px-2 py-1 rounded hover:underline focus-visible:outline-2 disabled:opacity-50"
+      style={{ color }}>
+      <span aria-live="polite">{status === 'copied' ? 'Copiado' : status === 'error' ? 'Reintentar' : label}</span>
+    </button>
+  );
+}
