@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix mex: <https://example.org/mex-ontologi/vocab/> .
@prefix shape: <https://example.org/mex-ontologi/shapes/> .

shape:RevisionCruceRonda3 a sh:NodeShape ; sh:targetClass mex:RevisionCruceRonda3 ;
    sh:property [ sh:path mex:estadoDecision ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ("exploratorio" "exploratorio_con_condiciones_pendientes" "habilitable_con_condiciones") ] ;
    sh:property [ sh:path mex:tipoEvidencia ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ("recomputo_agregados_fuente_historico" "validacion_original_2020" "union_listas_fuente_historico") ] ;
    sh:property [ sh:path mex:alcanceVerificacion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path mex:condicionPendiente ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

shape:ComparacionMunicipal2020 a sh:NodeShape ; sh:targetClass mex:ComparacionMunicipal2020 ;
    sh:property [ sh:path mex:comparacionDe ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mex:RevisionCruceRonda3 ] ;
    sh:property [ sh:path mex:codigoTextual ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^26[0-9]{3}$" ] ;
    sh:property [ sh:path mex:periodoCruzado ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "2020" ] ;
    sh:property [ sh:path mex:igualdadValores ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] ;
    sh:property [ sh:path mex:transformacionPrevia ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path mex:limiteInterpretativo ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path [ sh:inversePath mex:evidenciaDeFuente ] ; sh:minCount 2 ; sh:maxCount 2 ; sh:class mex:EvidenciaFuenteComparacion ] .

shape:EvidenciaFuenteComparacion a sh:NodeShape ; sh:targetClass mex:EvidenciaFuenteComparacion ;
    sh:property [ sh:path mex:evidenciaDeFuente ; sh:minCount 1 ; sh:maxCount 1 ; sh:class mex:ComparacionMunicipal2020 ] ;
    sh:property [ sh:path mex:fuenteOriginal ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path mex:fuenteRol ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("grandes_grupos" "indicadores") ] ;
    sh:property [ sh:path mex:codigoTextual ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^26[0-9]{3}$" ] ;
    sh:property [ sh:path mex:nombreOrigen ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path mex:valorOrigen ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path mex:medidaOrigen ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path mex:shaFuente ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path mex:hojaFuente ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path rdf:type ; sh:minCount 2 ; sh:maxCount 2 ;
        sh:in (mex:EvidenciaFuenteComparacion mex:EvidenciaGrandesGrupos2020 mex:EvidenciaIndicadores2020) ] .

shape:FilasGrandesGrupos a sh:NodeShape ;
    sh:targetClass mex:EvidenciaGrandesGrupos2020 ;
    sh:targetSubjectsOf mex:filaOrigenHombres, mex:filaOrigenMujeres ;
    sh:property [ sh:path mex:fuenteRol ; sh:hasValue "grandes_grupos" ] ;
    sh:property [ sh:path mex:filaOrigenHombres ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 2 ] ;
    sh:property [ sh:path mex:filaOrigenMujeres ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 2 ] ;
    sh:property [ sh:path mex:filaOrigen ; sh:maxCount 0 ] .

shape:FilaIndicadores a sh:NodeShape ; sh:targetClass mex:EvidenciaIndicadores2020 ; sh:targetSubjectsOf mex:filaOrigen ;
    sh:property [ sh:path mex:fuenteRol ; sh:hasValue "indicadores" ] ;
    sh:property [ sh:path mex:filaOrigen ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 2 ] ;
    sh:property [ sh:path mex:filaOrigenHombres ; sh:maxCount 0 ] ;
    sh:property [ sh:path mex:filaOrigenMujeres ; sh:maxCount 0 ] .
