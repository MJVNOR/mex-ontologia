<https://example.org/mex-ontologi/cruce-r3/F2> a mex:RevisionCruceRonda3 ;
    rdfs:label "F2 — Proyecciones Grandes grupos vs Indicadores"@es ;
    prov:wasDerivedFrom <file:///C:/Users/marti/Documents/MEX-Ontologi/propuestas/ronda-3/agente-5-cruces/fichas/F2.json> ;
    mex:alcanceVerificacion "Validacion NUEVA 2020 sobre originales fijados (7344 + 3672 filas reales leidas). No reutiliza la inspeccion heuristica anterior como prueba (quedo refutada)." ;
    mex:condicionPendiente "constructos distintos (suma de grupos vs mitad de ano): yuxtaposicion, no identidad de medida",
        "cruce ano por ano 1990-2040 NO ejecutado; solo 2020 cruzado",
        "sin equivalencia INEGI afirmada; codigos literales coincidentes",
        "vigencia de catalogos no_acreditada (F3/F4 ausentes): edition/aplicabilidad no demostrada" ;
    mex:condicionVerificada "SHAs de originales == manifiesto ronda 1",
        "cruce 2020: cobertura 72/72, nombres 72/72, coherencia POB 72/72",
        "filas con 11 columnas ordenadas por coordenada; 0 huecos, 0 formulas en el original",
        "headers reales resueltos (CLAVE,CLAVE_ENT,NOM_ENT,NOM_MUN,SEXO/ANO,medidas)",
        "suma de grupos == POB_TOTAL en 7344/7344",
        "unicidad (CLAVE,SEXO,ANO) y (CLAVE,ANO); 72 claves identicas" ;
    mex:estadoDecision "exploratorio_con_condiciones_pendientes" ;
    mex:limiteInterpretativo "causalidad",
        "cruce ano por ano 1990-2040",
        "equivalencia INEGI",
        "identidad de medida entre fuentes" ;
    mex:tipoEvidencia "validacion_original_2020" .

