<https://example.org/mex-ontologi/cruce-r3/F1> a mex:RevisionCruceRonda3 ;
    rdfs:label "F1 — Matrimonios-Divorcios 2022"@es ;
    prov:wasDerivedFrom <file:///C:/Users/marti/Documents/MEX-Ontologi/propuestas/ronda-3/agente-5-cruces/fichas/F1.json> ;
    mex:alcanceVerificacion "Recomputo desde agregados por fuente con huella + unicidad/dominio/periodo/catalogo. NO es validacion completa de filas fuente (sin relectura cruda)." ;
    mex:condicionPendiente "campo ano de divorcios sin respaldo de diccionario (solo columna de archivo)",
        "cobertura de meses no verificada en estas dos fuentes; solo ano 2022",
        "extension a otros anios exige revalidar recurso y diccionario por ano",
        "grano fila publicada sin deduplicacion de eventos; API sin instantanea transaccional",
        "sin catalogo de codigos locales del Registro Civil: <=72 no identifica municipios ni equivale a INEGI" ;
    mex:condicionVerificada "agregacion previa al join; union externa con ausencia NULL (62 observados, no 67)",
        "derivado cruce-registro-civil.json consistente con el recomputo",
        "dominio 2022 sin 26998/26999; huecos 07/39/44/54 ausentes en ambas",
        "mismo publicador Registro Civil en ambas",
        "municipio con sentido registro y misma descripcion en ambas (literales, no identidad)",
        "suma de agregados == total publicado en cada fuente",
        "unicidad (municipio,anio) en cada fuente 2022: 67 y 62 claves" ;
    mex:estadoDecision "exploratorio_con_condiciones_pendientes" ;
    mex:limiteInterpretativo "extension a otros anios sin revisar diccionarios",
        "nombres o codigos INEGI",
        "tasa de divorcio",
        "vinculo persona/cohorte" ;
    mex:tipoEvidencia "recomputo_agregados_fuente_historico" .

<https://example.org/mex-ontologi/cruce-r3/F3> a mex:RevisionCruceRonda3 ;
    rdfs:label "F3 — Titulados-Egresados 2020-2021 + Nuevo-Reingreso 2021-2022"@es ;
    prov:wasDerivedFrom <file:///C:/Users/marti/Documents/MEX-Ontologi/propuestas/ronda-3/agente-5-cruces/fichas/F3.json> ;
    mex:alcanceVerificacion "Union reconstruida desde listas por fuente de validacion-lote.json (xlsx UES leidos completos con sha; periodo de metadatos sin validacion externa). No es lectura de microdatos personales: conteos por (programa, sede)." ;
    mex:condicionPendiente "fuente agregada (listas por fuente con huella), no filas crudas",
        "grano programa/sede de una institucion: no extrapolable; no tasas ni cohortes",
        "identidad de programa por nombre literal UES: acentos/variantes no homologados",
        "periodo solo declarado en metadatos, sin validacion externa" ;
    mex:condicionVerificada "archivos xlsx leidos completos con sha (bfe28103, 3bdc9bc3, 9e898830, 2fe45473)",
        "claves con/sin acento conviven sin fusionarse (verificado, no homologado)",
        "mismo periodo declarado dentro de cada par (2020-2021 / 2021-2022)",
        "unicidad (programa, sede) reconstruida; sumas == totales; ausencia NULL, 0 publicado distinto" ;
    mex:estadoDecision "habilitable_con_condiciones" ;
    mex:limiteInterpretativo "homologacion de programas con/sin acento",
        "mezcla de periodos 2020-2021 con 2021-2022",
        "seguimiento de cohortes",
        "tasa de titulacion/egreso" ;
    mex:tipoEvidencia "union_listas_fuente_historico" .

mex:alcanceVerificacion a owl:DatatypeProperty ;
    rdfs:label "Alcance expreso de lo verificado"@es .

mex:codigoTextual a owl:DatatypeProperty ;
    rdfs:label "Codigo literal sin equivalencia INEGI"@es .

mex:comparacionDe a owl:ObjectProperty ;
    rdfs:label "Comparacion de la revision"@es .

mex:condicionPendiente a owl:DatatypeProperty ;
    rdfs:label "Bloqueo de uso interpretativo"@es .

mex:condicionVerificada a owl:DatatypeProperty ;
    rdfs:label "Condicion ya verificada"@es .

mex:estadoDecision a owl:DatatypeProperty ;
    rdfs:label "Decision de triaje de la ficha"@es .

mex:evidenciaDeFuente a owl:ObjectProperty ;
    rdfs:label "Evidencia aportada por la fuente en la comparacion"@es .

mex:filaOrigen a owl:DatatypeProperty ;
    rdfs:label "Fila unica de la hoja original"@es .

mex:filaOrigenHombres a owl:DatatypeProperty ;
    rdfs:label "Fila de HOMBRES en la hoja original"@es .

mex:filaOrigenMujeres a owl:DatatypeProperty ;
    rdfs:label "Fila de MUJERES en la hoja original"@es .

mex:fuenteOriginal a owl:ObjectProperty ;
    rdfs:label "Archivo original fijado"@es .

mex:fuenteRol a owl:DatatypeProperty ;
    rdfs:label "Fuente de la evidencia (grandes_grupos o indicadores)"@es .

mex:hojaFuente a owl:DatatypeProperty ;
    rdfs:label "Hoja del archivo original"@es .

mex:igualdadValores a owl:DatatypeProperty ;
    rdfs:label "Coherencia aritmetica, no identidad de medida"@es .

mex:limiteInterpretativo a owl:DatatypeProperty ;
    rdfs:label "Limite de interpretacion"@es .

mex:medidaOrigen a owl:DatatypeProperty ;
    rdfs:label "Medida publicada por la fuente"@es .

mex:nombreOrigen a owl:DatatypeProperty ;
    rdfs:label "Nombre literal de la fuente"@es .

mex:periodoCruzado a owl:DatatypeProperty ;
    rdfs:label "Periodo cruzado"@es .

mex:shaFuente a owl:DatatypeProperty ;
    rdfs:label "SHA-256 unico del archivo original"@es .

mex:tipoEvidencia a owl:DatatypeProperty ;
    rdfs:label "Alcance probatorio (historico vs original)"@es .

mex:transformacionPrevia a owl:DatatypeProperty ;
    rdfs:label "Agregacion previa al join"@es .

mex:valorOrigen a owl:DatatypeProperty ;
    rdfs:label "Valor agregado publicado por la fuente"@es .

