+    `REGEX(STR(?label), ${JSON.stringify(delimitedYearPattern(y))})`,
+    `REGEX(STR(?ini), ${JSON.stringify(delimitedYearPattern(y))})`,
+    `REGEX(STR(?fin), ${JSON.stringify(delimitedYearPattern(y))})`,
+  ]);
+  return ` && (${ors.join(' || ')})`;
