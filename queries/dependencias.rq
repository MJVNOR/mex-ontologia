PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
SELECT ?dependencia (COUNT(DISTINCT ?conjunto) AS ?conjuntos)
WHERE {
  ?conjunto a dcat:Dataset ; dct:publisher ?org .
  ?org foaf:name ?dependencia .
}
GROUP BY ?dependencia
ORDER BY DESC(?conjuntos) ?dependencia
