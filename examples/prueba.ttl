@prefix ex: <https://example.org/sonora-prueba/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Infraestructura a owl:Class ; rdfs:label "Infraestructura"@es .
ex:Presa a owl:Class ; rdfs:label "Presa"@es ; rdfs:subClassOf ex:Infraestructura .
ex:presaDePrueba a ex:Presa ; rdfs:label "Presa ficticia para verificar la instalacion"@es .
